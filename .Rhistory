plot_cells(atac, color_cells_by = "celltype", cell_size = 0.6, label_cell_groups = F)+scale_color_manual(values=ctcol)
regions <- rownames(atac)
split_regions <- strsplit(regions, "_")
chromosomes <- sapply(split_regions, `[`, 1)
starts <- as.integer(sapply(split_regions, `[`, 2))
ends <- as.integer(sapply(split_regions, `[`, 3))
# Create GRanges object
gr <- GRanges(seqnames = chromosomes,
ranges = IRanges(start = starts, end = ends))
rowRanges(atac) <- gr
