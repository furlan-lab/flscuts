pData(atac)$celltype <- factor(pData(atac)$celltype)
new_levels <- c(
"HSC" = "01_HSC",
"Early.Eryth" = "02_Early.Eryth",
"Late.Eryth" = "03_Late.Eryth",
"Early.Baso" = "04_Early.Baso",
"CMP.LMPP" = "05_CMP.LMPP",
"CLP.1" = "06_CLP",
"CLP.2" = "06_CLP",  # If multiple match, decide how to handle
"GMP" = "07_GMP",
"GMP.Neut" = "08_GMP.Neut",
"pDC" = "09_pDC",
"cDC" = "10_cDC",
"CD14.Mono.1" = "11_CD14.Mono",
"CD14.Mono.2" = "11_CD14.Mono",  # Merging to a single level
"CD16.Mono" = "12_CD16.Mono",
"Pre.B" = "13_Pre.B",
"B" = "14_B",
"Plasma" = "15_Plasma",
"CD8.N" = "16_CD8.N",
"CD4.N1" = "17_CD4.N",
"CD4.N2" = "17_CD4.N",  # Merging subtypes
"CD4.M" = "18_CD4.M",
"CD8.EM" = "19_CD8.EM",
