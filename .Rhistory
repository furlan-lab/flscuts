seur<-iterative_LSI(seur, num_dim = comps, num_features = length(vg), resolution = c(1e-3), verbose = T, starting_features = vg, run_umap = T)
seur@reductions$lsi@misc
seur@reductions$lsi@misc$svd
seur<-iterative_LSI(seur, num_dim = comps, num_features = length(vg), resolution = c(1e-3, 1e-3), verbose = T, starting_features = vg, run_umap = T)
seur@reductions$lsi@misc$svd
